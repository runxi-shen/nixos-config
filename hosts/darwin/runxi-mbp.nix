# Runxi's MacBook Pro. Everything here is true of THIS machine, not of "a Mac":
# the apps actually installed on it, its dock, its cloud-sync accounts, and the
# launchd agents for tools that live outside the Nix store on this box.
#
# Settings that should hold on every Mac live in ./default.nix.
#
# Account name is `runxishen` (uid 501, pre-dates the fleet's `rshen`
# convention). It is threaded in from mkDarwin rather than written here, so
# renaming this machine later means editing one string in flake.nix.
{ config, pkgs, lib, user, ... }:

{
  imports = [
    # Purdue OneDrive: the ~/Purdue_OneDrive alias and the tombstone that keeps
    # "OneDrive - purdue.edu" from ever appearing. Shared with rshen-mbp, which
    # signs into the same tenant.
    ../../modules/darwin/onedrive-purdue.nix

    # Always-on posture: sshd, tailscaled-as-daemon, never-sleep, clamshell.
    # This host lives on a shelf and is driven from a phone and the other Mac;
    # rshen-mbp deliberately does NOT import this.
    ../../modules/darwin/always-on-server.nix
  ];

  # This Mac runs Determinate Nix, which manages its own daemon; nix-darwin must
  # keep its hands off. A machine installed with the upstream Nix installer
  # wants `true` instead, which is why this is per-host rather than shared.
  # Verified: /run/current-system/etc has no nix.conf.
  nix.enable = false;

  # Apps installed by Homebrew rather than Nix -- per-machine by nature.
  homebrew.casks = pkgs.callPackage ../../modules/darwin/casks.nix { };

  # Make Homebrew AUTHORITATIVE on this host: anything installed that the config
  # does not name gets uninstalled on the next switch.
  #
  # READ THIS BEFORE COPYING IT TO ANOTHER HOST -- the scope is wider than it
  # looks. "cleanup" covers BOTH casks and FORMULAE, and `homebrew.brews` is
  # unset here, so the declared formula set is EMPTY and every hand-installed
  # formula is drift. Enabling this purged ten of them on first switch
  # (mkcert, potrace, gettext and seven dependencies). That is the intended
  # end state for this machine -- brew's job here is GUI casks, and CLI tools
  # come from Nix (the three worth keeping now live in homes/rshen/packages.nix)
  # -- but it is a one-way door the first time you flip it. Inventory with
  # `brew list --formula` and `brew list --cask` first.
  #
  # Set per-host rather than in modules/darwin/home-manager.nix because the
  # default ("none") is the right one for a machine a human uses interactively:
  # there, a hand-installed package is a decision, not drift. This host is
  # driven remotely and must match its config exactly, so the opposite holds.
  #
  # The motivating case: dropping "tailscale-app" from the cask list did NOT
  # uninstall it, because removal from the list only stops nix-darwin from
  # *managing* a cask. The GUI and its network extension stayed installed and
  # contended with the tailscaled daemon always-on-server.nix introduces.
  #
  # "uninstall" and not "zap": zap additionally deletes user data, so a package
  # briefly dropped from the config by mistake would take its settings with it.
  # Uninstall is recoverable; zap is not.
  homebrew.onActivation.cleanup = "uninstall";

  local.dock.entries = [
    { path = "/Applications/Slack.app/"; }
    { path = "/System/Applications/Messages.app/"; }
    { path = "${pkgs.alacritty}/Applications/Alacritty.app/"; }
    { path = "/System/Applications/Music.app/"; }
    { path = "/Applications/Google Chrome.app/"; }
    { path = "/Applications/Visual Studio Code.app/"; }
    { path = "/Applications/Claude.app/"; }
    { path = "/Applications/Discord.app/"; }
    {
      path = "${config.users.users.${user}.home}/.local/share/";
      section = "others";
      options = "--sort name --view grid --display folder";
    }
    {
      path = "${config.users.users.${user}.home}/.local/share/downloads";
      section = "others";
      options = "--sort name --view grid --display stack";
    }
  ];

  # Codex (Rust/rustls) trusts the Obsidian Local REST API's self-signed cert.
  # It reads CODEX_CA_CERTIFICATE, which is ADDITIVE to the native root store,
  # so this cannot affect trust for any other connection. Set via launchd so
  # the ChatGPT.app GUI inherits it -- it is not started from a shell, and
  # `launchctl setenv` does not survive a reboot.
  # NB: the cert expires 2027-06-14; ~/.codex/scripts/obsidian_ca_env.sh
  # re-exports it from the Obsidian plugin config when it rotates.
  #
  # Host-specific: the pem is generated by the Obsidian install on this Mac.
  launchd.user.envVariables.CODEX_CA_CERTIFICATE =
    "/Users/${user}/.claude/obsidian-local-rest-api.pem";

  # dsh (DeepSeek Harness) web UI. Owned by launchd rather than a shell so it
  # survives terminal exits and logouts, and KeepAlive restarts it if it dies.
  # ThrottleInterval stops a missing/broken npm tree from hot-looping.
  # WorkingDirectory is the agent's workspace root -- deliberately a dedicated
  # empty dir, since the harness ships bash and filesystem tools and would
  # otherwise take whatever directory it was launched from.
  # See modules/darwin/packages.nix for why node needs --expose-internals.
  #
  # Host-specific: points at an imperative npm tree under ~/.local/share/dsh.
  launchd.user.agents.dsh-web = {
    serviceConfig = {
      RunAtLoad = true;
      KeepAlive = true;
      ThrottleInterval = 30;
      WorkingDirectory = "/Users/${user}/dsh-workspace";
      StandardOutPath = "/tmp/dsh-web.out.log";
      StandardErrorPath = "/tmp/dsh-web.err.log";
      ProgramArguments = [
        "/bin/sh"
        "-c"
        "exec ${pkgs.nodejs_22}/bin/node --expose-internals \"$HOME/.local/share/dsh/node_modules/@deepseek-ai/dsh/lib/bin.js\" web --no-open --port 3080"
      ];
    };
  };

  home-manager.users.${user} = { config, lib, ... }: {
    # Clean-named shortcut to this machine's Nutstore sync root.
    #
    # mkOutOfStoreSymlink is essential here: a plain `source` would try to copy
    # the target into the nix store, which for a live cloud folder would be
    # catastrophic. This emits a direct symlink to the real path.
    #
    # The sync root itself is NEVER renamed -- Nutstore records its path in
    # ~/.nutstore/db/nutstore.db. This is an additive alias only.
    #
    # Host-specific: Nutstore is installed on this Mac only. rshen-mbp reaches
    # the same account over WebDAV (Zotero's file sync) and needs no client.
    # The Purdue OneDrive alias that used to live here moved to
    # modules/darwin/onedrive-purdue.nix when the second Mac grew it too.
    home.file."Nutstore".source = config.lib.file.mkOutOfStoreSymlink
      "${config.home.homeDirectory}/NutstoreFiles/Nutstore";
  };
}
