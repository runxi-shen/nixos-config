#!/bin/sh -e

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

# Resolve the host at runtime rather than hardcoding a system. darwinConfigurations
# is keyed by hostname, so the same script serves every Mac.
#
# An explicit argument wins, for the case where LocalHostName has drifted or you
# want to build another machine's config:  nix run .#build-switch -- rshen-mbp
if [ -n "$1" ] && ! echo "$1" | grep -q '^-'; then
  HOST="$1"
  shift
else
  HOST=$(scutil --get LocalHostName)
fi

FLAKE_SYSTEM="darwinConfigurations.\"${HOST}\".system"

export NIXPKGS_ALLOW_UNFREE=1

echo "${YELLOW}Building for host ${HOST}...${NC}"

# Membership test only. Deliberately NOT `nix eval .#<host>.system >/dev/null 2>&1`:
# that evaluates the whole system closure and discards stderr, so a genuine
# error -- a type error, a bad module path, or the classic "new file not `git
# add`ed so the flake cannot see it" -- would be reported as "unknown host"
# with no diagnostics at all. `builtins.attrNames` forces only the attrset
# spine, and any real evaluation failure now propagates verbatim from the
# build below, which `set -e` still aborts on before sudo is ever reached.
KNOWN=$(nix --extra-experimental-features 'nix-command flakes' eval \
  --json .#darwinConfigurations --apply 'builtins.attrNames')

if ! printf '%s' "$KNOWN" | grep -q "\"${HOST}\""; then
  echo "${RED}No darwinConfiguration named '${HOST}'.${NC}"
  echo "${YELLOW}Known hosts: ${KNOWN}${NC}"
  echo "${YELLOW}Add it to flake.nix, or pass one explicitly: nix run .#build-switch -- <host>${NC}"
  exit 1
fi

nix --extra-experimental-features 'nix-command flakes' build ".#${FLAKE_SYSTEM}" "$@"

echo "${YELLOW}Switching to new generation...${NC}"
# See https://github.com/nix-darwin/nix-darwin/issues/1457 on why we need sudo
sudo ./result/sw/bin/darwin-rebuild switch --flake ".#${HOST}" "$@"

echo "${YELLOW}Cleaning up...${NC}"
unlink ./result

echo "${GREEN}Switch to new generation complete!${NC}"
